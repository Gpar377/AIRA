# AIRA — Unified Environment Configuration
# Copy this file to .env in the root directory and fill in your values.

# 1. Google Gemini API Key
# Get a FREE API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Execution Mode (Set to true to run live cluster scanning and patching)
AIRA_LIVE_SCAN=true

# 3. Observability URLs (Defaults for local kind-cluster port-forwards)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# 4. Storage
DB_URL=sqlite:///aira_unified.db
LOG_LEVEL=INFO
