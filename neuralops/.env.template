# NeuralOps Environment Configuration
# Copy this to .env and fill in your values

# Application
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=neuralops
POSTGRES_PASSWORD=neuralops123
POSTGRES_DB=neuralops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kubernetes
K8S_NAMESPACE=default
K8S_IN_CLUSTER=false

# Observability
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# LLM (Required for agent reasoning)
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022

# Prediction
PREDICTION_INTERVAL_SECONDS=30
ANOMALY_THRESHOLD=0.85

# Autonomy
AUTONOMY_ROUTINE_THRESHOLD=0.9
AUTONOMY_MODERATE_THRESHOLD=0.7
