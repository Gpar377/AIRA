# SentinelArena — Environment Configuration
# Copy this to .env and fill in your values

# Get your FREE API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (gemini-2.0-flash is fast + free)
GEMINI_MODEL=gemini-2.0-flash

# Arena configuration
MAX_ROUNDS=8
SPIRAL_THRESHOLD=3
BLAST_RADIUS_LIMIT=0.75
RED_RATE_LIMIT_PER_ROUND=2

# Memory
MEMORY_FILE=memory_store/battle_memory.json
